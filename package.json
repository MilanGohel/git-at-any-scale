{
  "name": "git-at-any-scale",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "demo": "bun run src/demo.ts",
    "demo:s3": "bun run src/demo.ts --s3",
    "serve": "bun run src/server/git-http-server.ts",
    "deploy:lambda": "bash deploy/deploy-lambda.sh",
    "clone": "bun run src/scripts/clone-from-s3.ts",
    "test:s3": "bun run src/scripts/test-real-s3.ts",
    "test:s3:replication": "bun run src/scripts/test-real-s3-replication.ts",
    "test:s3:materialize": "bun run src/scripts/test-real-s3-materialize.ts",
    "test:s3:compact": "bun run src/scripts/test-real-s3-compact.ts",
    "test:s3:failover": "bun run src/scripts/test-real-s3-failover.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1141.0"
  }
